# Copiar a .env; completar localmente. Nunca publicar valores reales.
POSTGRES_DB=ecoconecta
POSTGRES_USER=ecoconecta
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
ADMINER_PORT=8080
WEB_PORT=5173
DB_APP_USER=ecoconecta_app
# Se genera mediante scripts.provision_runtime; distinto del propietario del esquema.
DB_APP_PASSWORD=
# Python local: codificar caracteres reservados de la contraseña en la URL.
DATABASE_URL=postgresql+psycopg://ecoconecta:REEMPLAZAR@127.0.0.1:5432/ecoconecta
# Secreto aleatorio de al menos 32 caracteres; no es una credencial de Meta.
AUTH_SECRET=
TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:5173
# Solo pruebas: base separada cuyo nombre termine en _test.
TEST_DATABASE_URL=postgresql+psycopg://ecoconecta:REEMPLAZAR@127.0.0.1:5432/ecoconecta_test

# Configuración opcional del frontend
VITE_API_URL=
VITE_WHATSAPP_NUMBER=

# Backend únicamente. Inyectar secretos desde el entorno de ejecución.
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
# Nombres de plantillas aprobadas sin parámetros e idioma, si están disponibles.
WHATSAPP_TEMPLATE_PROGRAMACION=
WHATSAPP_TEMPLATE_CIERRE=
WHATSAPP_TEMPLATE_RESPUESTA=
WHATSAPP_TEMPLATE_LANGUAGE=

# Login del panel, generado por python -m scripts.provision_runtime --panel
DB_PANEL_USER=ecoconecta_panel
DB_PANEL_PASSWORD=
WHATSAPP_PROVIDER=meta
OPENWA_URL=http://openwa:2785
OPENWA_SESSION_ID=
OPENWA_API_KEY=
OPENWA_WEBHOOK_SECRET=
ECO_IA_URL=
ECO_IA_TIMEOUT=15
